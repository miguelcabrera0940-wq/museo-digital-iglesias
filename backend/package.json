{
  "name": "iglesias-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "check:neon": "node scripts/verificar-neon.js",
    "admin:demo": "node --env-file-if-exists=.env scripts/cuentas-demo.js",
    "admin:crear": "node --env-file-if-exists=.env scripts/crear-administrador.js",
    "check:admin:proxy": "node scripts/verificar-proxy-admin.js",
    "contenido:preview": "node scripts/cargar-contenido.js --vista-previa",
    "contenido:comparar": "node scripts/cargar-contenido.js --comparar",
    "contenido:aplicar": "node scripts/cargar-contenido.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.0.0",
    "better-auth": "1.7.13"
  }
}
