# Solo placeholders. La credencial real va exclusivamente en backend/.env ignorado.
DATABASE_URL=postgresql://iglesias_backend:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
# Administración: login restringido; nunca el propietario de Neon.
DATABASE_URL_ADMIN=postgresql://iglesias_backend_admin:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
APP_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# En despliegue: NODE_ENV=production y APP_ORIGIN=https://YOUR_APP_HOST
